{
  "name": "playwright-typescript-e2e-framework",
  "version": "1.0.0",
  "description": "Modern Playwright TypeScript E2E testing framework",
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=webkit",
    "test:parallel": "playwright test --workers=4",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "ui": "playwright test --ui"
  },
  "keywords": ["playwright", "typescript", "e2e", "testing", "automation"],
  "author": "Cheetahrevive",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "dotenv": "^16.3.1"
  }
}
